generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuoteStatus {
  NEW
  CONTACTED
  QUOTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InstallationType {
  SHOP
  HOME_SERVICE
  UNSURE
}

enum ProjectImageType {
  BEFORE
  AFTER
  GALLERY
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Quote {
  id               String           @id @default(cuid())
  customerName     String
  phone            String
  email            String?
  carModel         String
  yearModel        Int
  installationType InstallationType
  preferredDate    DateTime?
  notes            String?
  status           QuoteStatus      @default(NEW)
  serviceId        String?
  materialId       String?
  service          Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  material         Material?        @relation(fields: [materialId], references: [id], onDelete: SetNull)
  images           QuoteImage[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  quoteServices    QuoteService[]
}

model Service {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  active        Boolean        @default(true)
  quotes        Quote[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  quoteServices QuoteService[]
}

model QuoteService {
  quoteId   String
  serviceId String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([quoteId, serviceId])
  @@index([serviceId])
}

model Material {
  id            String    @id @default(cuid())
  name          String    @unique
  type          String
  warrantyYears Int
  description   String?
  active        Boolean   @default(true)
  quotes        Quote[]
  projects      Project[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Project {
  id          String         @id @default(cuid())
  title       String
  carModel    String?
  yearModel   Int?
  description String?
  published   Boolean        @default(false)
  materialId  String?
  material    Material?      @relation(fields: [materialId], references: [id], onDelete: SetNull)
  images      ProjectImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ProjectImage {
  id        String           @id @default(cuid())
  imageUrl  String
  publicId  String?
  imageType ProjectImageType
  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
}

model QuoteImage {
  id        String   @id @default(cuid())
  imageUrl  String
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  review       String
  rating       Int?
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
